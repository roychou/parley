# Deployment secrets + config for the forward-clock stack. Copy to deploy/.env and fill
# in. deploy/.env is gitignored — never commit real credentials.

# ---- IBKR paper account (consumed by the gateway container's IBC) ----
TWS_USERID=your-ibkr-paper-username
TWS_PASSWORD=your-ibkr-paper-password
# TRADING_MODE is forced to 'paper' by compose + the image; do not set it live here.

# ---- Anthropic + EDGAR (consumed by the app container) ----
ANTHROPIC_API_KEY=your-key-here
# SEC EDGAR requires a User-Agent with contact info or it blocks requests.
EDGAR_USER_AGENT=parley-research your-email@example.com

# ---- Email alerts (run success/failure + the daily staleness watchdog) ----
# Provider-agnostic SMTP. Port 465 => implicit TLS; anything else => STARTTLS.
# Proton (pm.me) needs the paid Bridge for SMTP; a Gmail/Fastmail app password is simplest.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-bot@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-bot@gmail.com
ALERT_EMAIL_TO=you@example.com

# ---- Run config ----
PARLEY_MAX_LLM_USD=8
# Cron times in deploy/app/crontab are interpreted in this timezone.
TZ=Asia/Singapore
