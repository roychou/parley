# supercronic crontab — times are in the container's TZ (set TZ in .env; default UTC).
# Fields: minute hour day-of-month month day-of-week  command
#
# Weekly forward session: Sunday 17:00. Decide on the week's closed data, mirroring the
# old launchd schedule. PARLEY_MAX_LLM_USD caps spend (expanded by the shell at run time).
0 17 * * 0 cd /app && python -m src.forward.run --max-llm-usd "${PARLEY_MAX_LLM_USD:-8}" >> /app/data/forward/logs/cron.log 2>&1

# Daily watchdog 09:00: emails if the last weekly run is missing/errored/stale (>8 days),
# so a silently-skipped Sunday is caught within a day instead of going unnoticed.
0 9 * * * cd /app && python -m src.forward.run --healthcheck >> /app/data/forward/logs/healthcheck.log 2>&1
